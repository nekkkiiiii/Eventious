# Copy this file to .env and adjust for your setup.
PORT=3000

# MySQL (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eventious

# Hosted MySQL (needed on Vercel): turn on SSL. If your provider gives you a CA
# certificate (Aiven does), paste the whole PEM into DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
